{
  "name": "labs-fastify-poc",
  "version": "1.0.0",
  "description": "A small lead-export API on Fastify, built around a job that survives a restart",
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p test/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fastify/mongodb": "^10.0.2",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "typebox": "^1.4.2"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
